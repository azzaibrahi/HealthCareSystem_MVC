@model PaginatedList<PatientViewModel>
@{
    ViewData["Title"] = "Patients";
}

<a asp-action="Create" class="btn btn-outline-primary m-3">Create New Patient</a>

<div class="mt-2">
    <form asp-action="Index" method="get" class="row offset-2">
        <div class="col-10">
            <input class="form-control" placeholder="Patient's Name" name="searchValue" value="@Context.Request.Query["searchValue"]" />
        </div>
        <div class="col-2">
            <input type="submit" class="btn btn-info" value="Search" />
        </div>
    </form>
</div>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <td>Name</td>
            <td>Date Of Birth</td>
            <td>Details</td>
            <td>Edit</td>
            <td>Delete</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.Name</td>
                <td>@patient.DateOfBirth.ToString("yyyy-MM-dd")</td>
                <partial name="_ButtonsPartial" model="@patient.Id"></partial>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Patient Pages">
    <ul class="pagination">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span>
        </li>
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
        </li>
    </ul>
</nav>
