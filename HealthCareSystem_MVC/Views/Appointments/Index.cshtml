@model PaginatedList<AppointmentViewModel>
@{
    ViewData["Title"] = "Appointments";
}

<a asp-action="Create" class="btn btn-outline-primary m-3">Create New Appointment</a>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <td>Patient</td>
            <td>Doctor</td>
            <td>Appointment Date</td>
            <td>Details</td>
            <td>Edit</td>
            <td>Delete</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.Patient?.Name</td>
                <td>@appointment.Doctor?.Name</td>
                <td>@appointment.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                <partial name="PartialViews/_AppointmentButtonsPartial" model="appointment"></partial>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Appointment Pages">
    <ul class="pagination">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span>
        </li>
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
        </li>
    </ul>
</nav>
