@model AppointmentViewModel

<div class="form-group">
    <label asp-for="PatientId"></label>
    <select class="form-control" asp-for="PatientId" asp-items="ViewBag.Patients">
        <option value="">-- Select Patient --</option>
    </select>
    <span class="text-danger" asp-validation-for="PatientId"></span>
</div>
<div class="form-group mt-2">
    <label asp-for="DoctorId"></label>
    <select class="form-control" asp-for="DoctorId" asp-items="ViewBag.Doctors">
        <option value="">-- Select Doctor --</option>
    </select>
    <span class="text-danger" asp-validation-for="DoctorId"></span>
</div>
<div class="form-group mt-2">
    <label asp-for="AppointmentDate"></label>
    <input class="form-control" asp-for="AppointmentDate" />
    <span class="text-danger" asp-validation-for="AppointmentDate"></span>
</div>
