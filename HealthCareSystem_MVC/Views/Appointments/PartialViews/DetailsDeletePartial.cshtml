@model AppointmentViewModel

<div class="form-group">
    <label>Patient</label>
    <input class="form-control" value="@Model.Patient?.Name" readonly />
</div>
<div class="form-group mt-2">
    <label>Doctor</label>
    <input class="form-control" value="@Model.Doctor?.Name" readonly />
</div>
<div class="form-group mt-2">
    <label asp-for="AppointmentDate"></label>
    <input class="form-control" value="@Model.AppointmentDate.ToString("yyyy-MM-dd HH:mm")" readonly />
</div>
